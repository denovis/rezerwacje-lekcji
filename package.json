{
  "name": "rezerwacje-lekcji",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Rezerwacje lekcji indywidualnych z pakietami, płatnościami online i gotówką — wiele firm w jednej bazie.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx --env-file-if-exists=.env db/migrate.ts",
    "db:app-login": "tsx --env-file-if-exists=.env db/app-login.ts",
    "db:seed": "tsx --env-file-if-exists=.env db/seed-dev.ts",
    "db:types": "kysely-codegen --dialect postgres --camel-case --exclude-pattern schema_migrations --out-file src/lib/db-types.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "kysely-codegen": "^0.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "better-auth": "^1.7.20",
    "kysely": "^0.29.8",
    "next": "^16.4.6",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "stripe": "^23.1.0"
  }
}
