# Skopiuj do .env i uzupełnij. Plik .env nie trafia do repozytorium.

# Właściciel bazy: migracje i dane startowe (Postgres z docker-compose.yml).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/rezerwacje

# Aplikacja łączy się rolą app_user, więc RLS działa dla każdego zapytania.
# Hasło z tego adresu ustawia: npm run db:app-login
APP_DATABASE_URL=postgres://app_user:app_user@localhost:5433/rezerwacje

# Logowanie. Klucz: co najmniej 32 znaki; na serwerze losowy, np. z: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=lokalny-klucz-tylko-do-pracy-na-komputerze

# Maile. Lokalnie Mailpit z docker-compose: podgląd wysłanych maili na http://localhost:8025
# Bez SMTP_URL maile trafiają tylko do logu serwera.
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Rezerwacje lekcji <rezerwacje@localhost>"

# Płatności online (Stripe). Bez STRIPE_SECRET_KEY płatności online są wyłączone.
# Lokalnie tylko klucz testowy: panel Stripe → Developers → API keys → Secret key (sk_test_…).
# Sekret webhooka wypisuje: stripe listen --forward-to localhost:3000/api/stripe/webhook (whsec_…).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
